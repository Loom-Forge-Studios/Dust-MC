# Dust — example configuration.
#
# Every setting has a default, so this whole file is optional: a Dust with no
# dust.toml at all runs on the defaults. Copy this to `dust.toml` and change
# what you want changed.
#
# The complete reference, generated from the server's own types, is in
# docs/configuration.md. Anything not listed there is not a setting.

[server]
bind = "0.0.0.0:25565"
motd = "A Dust server"
max_players = 20
online_mode = true

# How far players can see, in chunks. 441 columns at 10, 289 at 8, 25 at 2.
# Lower it on a small machine or a busy one: it is what each player costs in
# memory and in columns to send, though not in how long they wait to start
# playing — the world appears once the nearest columns arrive, whatever this
# says. A client that asks for less than this gets what it asked for; one that
# asks for more gets this.
view_distance = 10

# How far a player may reach to break or place a block, in blocks, measured
# from their eyes to the nearest point of the block. Past it the server ignores
# what they did. A vanilla client reaches 4.5 and vanilla's server refuses past
# 5.5; the extra half block here covers a crouching player's lower eyes and a
# position packet a tick behind the click that followed it. Raise it for a
# modded client that reaches further. Below 5 it starts refusing ordinary play,
# and the server refuses to start rather than let you find that out in game.
interaction_range = 6.0

# How far a player may move in one tick, in blocks, before the server stops
# believing them and teleports them back where they were. Measured against a
# real client rather than guessed: over 1,217 movement packets covering
# walking, sprinting, sprint-jumping, creative flight, a 300-block free fall
# and a walk through a 700 ms network stall, the largest single tick was 3.58
# blocks, and a long enough fall converges on 3.92. Ten is what vanilla allows
# a player who is not flying an elytra, and the room over honest play is the
# point: knockback, elytra and riptide are all faster than walking. Raise it
# for a server with movement mods; `inf` turns the check off. Below 4 the
# server refuses to start, because below 4 it would correct people for falling.
movement_speed_limit = 10.0

# After a stall (a slow disk, a paused laptop) the tick loop repays at most
# this many ticks per pass and skips past anything longer. Twenty is one
# second of game time: shorter stalls catch up smoothly, longer ones are
# skipped rather than chased.
max_catchup_ticks = 20

# How long a shutdown may take after ctrl-C before the server ends itself by
# force. Raise it if a world this size needs longer to save.
shutdown_timeout_secs = 10

# Whether the sun moves. Minecraft's doDaylightCycle game rule, as a setting.
#
# On, a day takes twenty minutes and the world remembers where the sun was
# across a restart — in Dust's own save, and in the world's level.dat when it
# has one, so opening the world in Minecraft shows the same time of day. Off,
# the sun stops where it was left, which is what a build server wants; the
# world's age still counts up either way.
#
# Not a performance setting. A running clock costs two and a half nanoseconds a
# tick and eighteen bytes per player per second, and turning it off saves
# neither: the sun is kept as an offset from the world's age, so a stopped
# cycle is the same single addition.
daylight_cycle = true

# Lowest severity logged: error, warn, info, debug or trace.
log_level = "info"

# Which game mode joining players are put in: survival or creative.
#
# Not a cosmetic byte. A creative client takes a block away the instant it is
# clicked and never asks the server how long that should have taken; a survival
# client animates a break of a length it works out itself and waits. Set this
# to survival and the server times every break against the hardness in
# dust-constants.tsv and the tool in the player's hand — see decision record
# 0028. Creative is the default because that is the mode this server's content
# is: there is no crafting, no furnace, no hunger and no health yet, and a
# survival player's only way to get a block is to mine one.
game_mode = "creative"

[jvm]
# Turning this off runs the server with no JVM in the process. Everything
# except plugins keeps working — that is a guarantee with a test behind it,
# not a hope.
enabled = true
max_heap_mib = 1024

# ---------------------------------------------------------------------------
# How common each ore is.
#
# Every number here is a multiplier on what this world would have generated
# anyway, so it keeps meaning the same thing if you add a datapack such as
# Terralith later. 1.0 is untouched, 2.0 is twice as much, 0.5 is half.
#
# These settings apply to terrain generated from here on. Chunks you have
# already explored are on disk and do not change.
# ---------------------------------------------------------------------------
[worldgen.ores]
enabled = true

# Applies to any ore with no entry of its own below.
default_frequency = 1.0

# Diamond, three times as common, in veins half again as large, and reaching
# further up than it normally would.
[worldgen.ores.overrides.diamond]
frequency = 3.0
vein_size = 1.5
max_y = 48

# Iron a little scarcer, without touching anything else about how it generates.
[worldgen.ores.overrides.iron]
frequency = 0.75

# Coal in bigger, rarer seams. Roughly the same amount of coal in the world,
# found less often and worth more when it is.
[worldgen.ores.overrides.coal]
frequency = 0.4
vein_size = 2.5

# Emerald everywhere rather than only in mountains is not something these
# settings can do — they change how much of an ore there is and where in the
# world's vertical range it sits, not which biomes it chooses. Biome placement
# is a datapack's job.
#
# Ore names are: coal, copper, iron, gold, redstone, lapis, diamond, emerald,
# nether_quartz, nether_gold, ancient_debris — plus anything a datapack adds,
# written as `namespace:name`. A name this world does not have is an error at
# startup naming the closest match, not a line that silently does nothing.

# ---------------------------------------------------------------------------
# Where Minecraft's own data lives.
#
# Dust ships none of Minecraft's content. It knows the *names* of every biome
# and dimension type, because those are part of the protocol, but not what is
# in them — a biome's colours and a dimension's height belong to Mojang and
# come from the copy of Minecraft you already have.
#
# You only need this to serve clients that do not track data packs, which is
# most bots and proxies (mineflayer among them). Ordinary Minecraft clients
# have their own copy and are unaffected either way.
#
# Point it at a directory in the usual data pack layout — the one containing
# `minecraft/`. Unpacking a server jar with `cargo xtask extract` produces one.
#
# Dust reads two more files from here. `dust-constants.tsv` says what
# Minecraft's own code says about a block state — how much light it stops, how
# much it gives off, which of the six heightmaps count it, whether a block
# placed there goes into it, and what it sounds like going down. `dust-items.tsv` says which block each item puts down. None
# of that is data: it is Java, so it is not in the directory above and there is
# no copy of it in Dust either. You make both from your own server jar:
#
#   cargo xtask extract --version 1.21.1 --only constants
#   cp .dust-extract/oracle-1.21.1/constants.tsv /path/to/minecraft/data/dust-constants.tsv
#   cp .dust-extract/oracle-1.21.1/items.tsv     /path/to/minecraft/data/dust-items.tsv
#
# Without the first, sky light stops dead at the surface of an ocean and under
# a tree, because every block but air is treated as a wall; the sky starts
# above the grass rather than through it; a placed block makes no sound; and a
# right-click replaces whatever sits on the face it clicked, rather than going
# into the tall grass it was aimed at and refusing the wall it was not.
# Without the second, a right-click puts down the world's own surface block
# whatever the player is holding. With them, the sky light Dust serves is the
# light Minecraft computes and a player places what they are holding. A file
# that is here and unreadable stops the server rather than being ignored.
# ---------------------------------------------------------------------------
# [data]
# path = "/path/to/minecraft/data"
